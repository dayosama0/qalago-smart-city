# Copy this file to .env in the same folder as app.py. Never commit .env.
# Add your own Groq key locally, or use Cloud Advanced settings > Secrets.
# With no key, AI search reports a configuration error unless reserve mode
# is explicitly enabled in the application's additional conditions.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# 1: current Open-Meteo weather; 0: disable live requests.
# Labeled simulated weather remains available in either setting.
WEATHER_ENABLED=1
